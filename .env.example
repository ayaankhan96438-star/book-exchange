# Supabase PostgreSQL connections (keep both values private)
# Runtime transaction-pooler URL (commonly port 6543)
DATABASE_URL="postgresql://prisma.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
# Session pooler or direct connection used by Prisma migrations (commonly port 5432)
DIRECT_URL="postgresql://prisma.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require"

# Admin access: use unique, strong values
ADMIN_PASSWORD="change-this-to-a-strong-unique-password"
ADMIN_SESSION_SECRET="replace-with-a-random-32-plus-character-secret"

# Cloudinary signed image uploads (server-side only)
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Public business details (defaults are already set in src/lib/config.ts)
NEXT_PUBLIC_BRAND_NAME="Book Exchange"
NEXT_PUBLIC_AREA="Krishna Nagar, Delhi"
NEXT_PUBLIC_CITY="Delhi"
NEXT_PUBLIC_ADDRESS="H6, Krishna Nagar, Delhi 110051"
NEXT_PUBLIC_WHATSAPP="919643833192"
NEXT_PUBLIC_PHONE_NUMBER="+919643833192"
NEXT_PUBLIC_INSTAGRAM="https://www.instagram.com/whoisbombastic/"
NEXT_PUBLIC_OWNER_NAME="The Book Exchange Team"
NEXT_PUBLIC_ABOUT="A small, home-run non-fiction book exchange in Krishna Nagar, Delhi."
NEXT_PUBLIC_SITE_URL=""
