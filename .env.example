# Supabase PostgreSQL connections
# Runtime pooler URL (transaction mode, commonly port 6543)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Session pooler or direct connection for migrations (commonly port 5432)
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Admin login secret: use a long, unique random string (not a shared or guessable password)
ADMIN_PASSWORD="change-this-to-a-strong-unique-password"
ADMIN_SESSION_SECRET="replace-with-a-random-32-plus-character-secret"

# Cloudinary credentials (server-side only; never expose API secret with NEXT_PUBLIC_)
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Home-run book exchange details
NEXT_PUBLIC_BRAND_NAME="PageTurn Exchange"
NEXT_PUBLIC_AREA="Your general area"
NEXT_PUBLIC_OWNER_NAME="Your name"
NEXT_PUBLIC_ABOUT="A short introduction about you and your home-run book exchange."
NEXT_PUBLIC_WHATSAPP_NUMBER="91XXXXXXXXXX"
NEXT_PUBLIC_PHONE_NUMBER="+91XXXXXXXXXX"
NEXT_PUBLIC_INSTAGRAM_URL="https://instagram.com/your-handle"

NEXT_PUBLIC_SITE_URL="https://your-domain.in"
